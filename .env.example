# Local SSR routing only. Do not put secrets in browser/client environment files.
USER_MANAGEMENT_GATEWAY_URL=http://localhost:8083
JOB_FINDER_GATEWAY_URL=http://localhost:8080
LOCATION_GATEWAY_URL=http://localhost:8081
# UMG-owned fixed local cookie names. Production must explicitly set production.
BFF_SESSION_COOKIE_PROFILE=local
NG_ALLOWED_HOSTS=localhost,127.0.0.1,job-seeker-copilot-client
BFF_JSON_BODY_LIMIT_BYTES=65536
BFF_DOWNSTREAM_TIMEOUT_MS=5000
BFF_REQUEST_TIMEOUT_MS=15000
BFF_HEADERS_TIMEOUT_MS=10000
BFF_KEEP_ALIVE_TIMEOUT_MS=5000
# Required only when the beta-disabled payment route is deliberately enabled.
# Supply this server-side through the runtime secret store; never expose it to Angular.
BFF_TO_PAYMENT_GATEWAY_TOKEN=
# Optional public, non-secret HTTPS submission endpoint. Empty keeps feedback disabled.
PUBLIC_FEEDBACK_API_URL=
# Required when PUBLIC_FEEDBACK_API_URL is set; public release/build identifier only.
PUBLIC_APP_RELEASE_ID=
