/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/app/app.spec.ts",
    "src/app/config/**/*.spec.ts",
    "src/app/features/claimant-profile/claimant-profile.spec.ts",
    "src/app/features/job-card/job-card.component.spec.ts",
    "src/app/features/job-results/job-results.component.spec.ts",
    "src/app/features/landing-auth/landing-auth.spec.ts",
    "src/app/gateways/**/*.spec.ts",
    "src/app/services/**/*.spec.ts",
    "src/server/**/*.spec.ts",
    "src/app/shared/**/*.spec.ts",
    "src/shared/**/*.spec.ts"
  ]
}
