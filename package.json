{
  "name": "job-seeker-copilot-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "cross-env ng serve --port=3000 --host=0.0.0.0 --allowed-hosts=true ${DISABLE_HMR:+--live-reload=false}",
    "build": "ng build",
    "prebuild": "npm run api:generate",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretest": "npm run api:generate && npm run test:contracts",
    "test:contracts": "node --test tools/contract-manifest.test.mjs",
    "lint": "ng lint",
    "prelint": "npm run api:generate",
    "api:verify": "node tools/contract-manifest.mjs",
    "api:generate": "node tools/generate-api-clients.mjs",
    "serve:ssr:job-seeker-copilot-client": "node dist/job-seeker-copilot-client/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.18",
    "@angular/platform-server": "21.2.18",
    "@angular/router": "21.2.18",
    "@angular/ssr": "21.2.19",
    "express": "^5.1.0",
    "motion": "^12.23.24",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.18",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "axe-core": "4.12.1",
    "cross-env": "^10.1.0",
    "eslint": "10.8.0",
    "jsdom": "^27.0.0",
    "postcss": "8.5.18",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.0"
  }
}
