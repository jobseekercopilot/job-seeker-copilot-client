{
  "name": "job-seeker-copilot-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "cross-env ng serve --port=3000 --host=0.0.0.0 --allowed-hosts=true ${DISABLE_HMR:+--live-reload=false}",
    "build": "ng build",
    "prebuild": "npm run api:generate",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretest": "npm run api:generate && npm run test:contracts",
    "test:contracts": "node --test tools/bundle-budget.test.mjs tools/contract-manifest.test.mjs tools/manual-boundary-contract.test.mjs",
    "lint": "ng lint",
    "prelint": "npm run api:generate",
    "api:verify": "node tools/contract-manifest.mjs && node tools/manual-boundary-contract.mjs",
    "api:generate": "node tools/generate-api-clients.mjs",
    "api:generate:verify": "node tools/verify-api-generation.mjs && npm run api:generate && tsc --noEmit --skipLibCheck --experimentalDecorators --target ES2022 --module ES2022 --moduleResolution bundler src/app/api/job-finder/index.ts src/app/api/document-generation-gateway/index.ts",
    "serve:ssr:job-seeker-copilot-client": "node dist/job-seeker-copilot-client/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.23",
    "@angular/platform-server": "21.2.23",
    "@angular/router": "21.2.23",
    "@angular/ssr": "21.2.23",
    "express": "^5.1.0",
    "motion": "^12.23.24",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.23",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "axe-core": "4.12.1",
    "cross-env": "^10.1.0",
    "eslint": "10.8.0",
    "fast-check": "^4.9.0",
    "jsdom": "^27.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.29.0"
    },
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.7",
    "ip-address": "10.4.0",
    "node-gyp": {
      "undici": "6.28.0"
    }
  }
}
